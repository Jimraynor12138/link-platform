# 复制为 .env 后按需修改（.env 已被 .gitignore 排除）
# 全部都有默认值，不建 .env 也能起，但生产必须改

# JWT 签名密钥：>=32 字节，link-auth 与 link-gateway 必须完全一致
LINK_AUTH_JWT_SECRET=link-platform-demo-jwt-secret-please-change-32bytes

# MySQL root 密码（容器初始化与业务连接共用）
MYSQL_ROOT_PASSWORD=link123456

# RabbitMQ 账号（不能用 guest：guest 只允许回环连接）
RABBITMQ_USER=link
RABBITMQ_PASS=link123456

# 短链域名：指向网关，收口后 8082 对外不可达
LINK_CORE_DOMAIN=localhost:8080

# 压测开关（默认值即正常业务）
# LINK_CORE_MQ_ENABLED=true
# LINK_CORE_MQ_TYPE=rabbit
# LINK_CORE_ANTI_ABUSE_ENABLED=true
