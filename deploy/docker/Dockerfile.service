# ============================================================
# 通用 Spring Boot 服务镜像（link-gateway / link-auth / link-core 共用）
#
# 构建前提（宿主机先打包，避免在容器内重复下载 Maven 依赖）：
#   mvn clean package -DskipTests
#
# 分层解包（layered jar）→ 依赖层和业务层分开，改代码只重建最后一层。
# Boot 3.2.5 的启动器在 loader.launch 包（不是 loader.JarLauncher）。
#
# 基础镜像用本地已有的 eclipse-temurin:17-jre（Debian 版，无 wget/curl，
# 所以 compose 的 healthcheck 用 bash 的 /dev/tcp 探活）。
# ============================================================
FROM eclipse-temurin:17-jre AS builder

ARG JAR_FILE
WORKDIR /app
COPY ${JAR_FILE} app.jar

# 解包后删掉本地凭据配置：.gitignore 只挡 git，不挡 Maven（application-dev.yml 会被打进 jar）
RUN java -Djarmode=layertools -jar app.jar extract \
 && rm -f application/BOOT-INF/classes/application-dev.yml \
          application/BOOT-INF/classes/application-local.yml

FROM eclipse-temurin:17-jre

# P2-1：固化 UTF-8（JDK 17 + 非 UTF-8 locale 下 Nacos 中文配置会挂）
# MaxRAMPercentage：容器内存自适应，避免 -Xmx 写死
ENV TZ=Asia/Shanghai \
    JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8 -XX:MaxRAMPercentage=75"

WORKDIR /app
COPY --from=builder /app/dependencies/ ./
COPY --from=builder /app/spring-boot-loader/ ./
COPY --from=builder /app/snapshot-dependencies/ ./
COPY --from=builder /app/application/ ./

ENTRYPOINT ["java", "org.springframework.boot.loader.launch.JarLauncher"]
